rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    function premium(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid)) &&
        get(/databases/$(database)/documents/entitlements/$(uid)).data.premiumUntilMillis > request.time.toMillis();
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid) &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'lastSeenAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.lastSeenAt == request.time;
      allow delete: if owner(uid);
      match /private/backup {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && premium(uid) &&
          request.resource.data.keys().hasOnly(['payload','updatedAt']) &&
          request.resource.data.payload is string && request.resource.data.payload.size() <= 700000 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if owner(uid);
      }
    }
    match /push_devices/{deviceId} {
      function ownerDevice() {
        return request.auth != null &&
          deviceId.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]{22}$');
      }
      allow read, delete: if ownerDevice() && resource.data.uid == request.auth.uid;
      allow create: if ownerDevice() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid','fcmToken','platform','enabled','reminders','updatedAt']) &&
        request.resource.data.fcmToken is string &&
        request.resource.data.fcmToken.size() <= 4096 &&
        request.resource.data.platform in ['ios','android'] &&
        request.resource.data.enabled is bool &&
        request.resource.data.reminders is list &&
        request.resource.data.reminders.size() <= 60 &&
        request.resource.data.updatedAt == request.time;
      allow update: if ownerDevice() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken','platform','enabled','reminders','updatedAt']) &&
        request.resource.data.reminders is list &&
        request.resource.data.reminders.size() <= 60 &&
        request.resource.data.updatedAt == request.time;
    }
    match /entitlements/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /orders/{id} { allow read: if admin(); allow write: if false; }
    match /audit/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
