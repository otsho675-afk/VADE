{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null && auth.token.admin == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "connections": {
          "$connection": {
            ".validate": "newData.isBoolean() && newData.val() == true"
          }
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
